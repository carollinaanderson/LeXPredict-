# Copy to .env and fill in. NEVER commit .env.
# .env holds secrets and machine-specific paths -- not the data itself.
# Real (sensitive) data stays outside the repo, in RAW_DATA_DIR, on an encrypted disk.

# Secret key for pseudonymizing names / case numbers (HMAC-SHA256). Generate: openssl rand -hex 32
# If this leaks, pseudonyms of low-entropy values (e.g. CPF) can be brute-forced. Rotate if exposed.
ANONYMIZATION_PEPPER=

# Where the raw (identifiable) export lives. Keep it OUTSIDE this repository.
RAW_DATA_DIR=/secure/volume/raw

# Derived, anonymized artefacts (all gitignored)
DATA_DIR=./data
MODEL_DIR=./models
DB_PATH=./data/claims.db

MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Required by the API (X-API-Key header). Generate: openssl rand -hex 24
API_KEY=
